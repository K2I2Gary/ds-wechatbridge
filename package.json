{
  "name": "dsh-wechat-bridge",
  "version": "1.9.7",
  "description": "通到微信：DSH 里的 AI 伙伴和微信双向互通。读微信本地库收消息、UI 自动化发消息，支持人格画像与对话温度、收图看表情包、@ 语义与历史记忆检索（RAG）、群聊上下文与日记、主人权限、群回复频率。",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bridge",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "wechat",
    "weixin",
    "wechatauto",
    "bridge"
  ],
  "author": "Yuuyuko-uu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K2I2Gary/ds-wechatbridge.git"
  },
  "homepage": "https://github.com/K2I2Gary/ds-wechatbridge#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "contributors": [
    {
      "name": "thawline",
      "url": "https://github.com/thawline"
    },
    {
      "name": "K2I2Gary",
      "url": "https://github.com/K2I2Gary"
    }
  ]
}
